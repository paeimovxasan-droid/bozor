# TORTINMANG.UZ — Namuna .env fayli
# Buni .env ga nusxalab, o'z ma'lumotlaringizni kiriting: cp .env.example .env

# ─── DeepSeek AI — YAGONA AI PROVAYDER (MUHIM) ─────────────────
# Rasmiy docs: https://api-docs.deepseek.com
# API key olish: https://platform.deepseek.com → API Keys → Create new API key
#
# ⚠️ DIQQAT: eski `deepseek-chat` / `deepseek-reasoner` model nomlari
# 2026-07-24 da TO'LIQ o'chirilgan. Hozir faqat quyidagilar ishlaydi:
#   deepseek-flash   — arzon va tez (bot uchun tavsiya etiladi)
#   deepseek-v4-pro  — chuqur reasoning (qimmatroq)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking (o'ylash) rejimi: none=tez/arzon (tavsiya) | low | high | max
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_MAX_TOKENS=1500
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT=30

# ─── Libertex / ForexClub MT5 — ASOSIY broker ──────────────────
# Libertex: https://libertex.org → Shaxsiy kabinet → MT5 hisob → Login/Parol/Server
# ForexClub MT5 serverlari:
#   Real: ForexClub-MT5 Real Server (mt5-real-prim.fxclub.org)
#   Demo: ForexClub-MT5 Demo Server (mt5-demo-prim.fxclub.org)
# DIQQAT: Server nomini aynan Libertex kabinetidagi kabi yozing!
# Agar MT5 ulanmasa, bot demo/paper rejimda ishlaydi (savdo qilinmaydi).
MT5_LOGIN=12345678
MT5_PASSWORD=sizning_parolingiz
MT5_SERVER=ForexClub-MT5 Real Server
MT5_PATH=
BROKER=ForexClub

# ─── Fokus bozorlar va tahlil tezligi ─────────────────────────
# Asosiy tahlil/savdo qilinadigan symbollar (vergul bilan, bo'shliqsiz)
FOCUS_MARKETS=XAUUSD,ETHUSD
# Tahlil sikli davri (soniya) — 60 = har daqiqa
CYCLE_SECONDS=60
# true qilsangiz — fokus emas, barcha bozorlar skanerlanadi
SCAN_ALL_MARKETS=false

# ─── Signal sezgirligi (ehtiyotkorlik bilan!) ────────────────
# Signal minimum ishonchi (default 45). Pastroq = ko'proq signal/savdo.
MIN_CONFIDENCE=45
# Trend kuchi minimum ADX (default 20). Pastroq = choppy bozorda ham savdo.
MIN_ADX=20
# Yo'nalish ball ostongi (default 14). Pastroq = ko'proq signal.
# KO'PROQ SAVDO xohlasangiz masalan: MIN_CONFIDENCE=40, MIN_ADX=18, SIGNAL_STRENGTH=12
SIGNAL_STRENGTH=14

# ─── Smart Dogon (DCA-recovery) ──────────────────────────────
# Zarardagi pozitsiyaga yangi tasdiq signal kelsa — qo'shimcha kirish.
# NAZORATSIZ MARTINGALE EMAS: max 1 dogon, lot oshmaydi, zarar >2% da yo'q.
DOGON_ENABLED=true
DOGON_MAX=1
DOGON_LOT_MULT=1.0
DOGON_MIN_CONF=50
DOGON_MAX_LOSS_PCT=2.0
DOGON_COOLDOWN=1800

# ─── Binance (Ixtiyoriy) ─────────────────────────────────────
# Agar Binance ham kerak bo'lsa: ENABLE_BINANCE=true
ENABLE_BINANCE=false
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# ─── Telegram (ixtiyoriy, lekin tavsiya etiladi) ───────────────
TELEGRAM_BOT_TOKEN=1234567890:AAH...
TELEGRAM_CHAT_ID=1234567890

# ─── Database (ixtiyoriy) ────────────────────────────────────
DB_URL=postgresql://ultra:ultra123@localhost:5432/tortinmang_uz
REDIS_URL=redis://localhost:6379
API_PORT=8000

# ─── v2.0 sozlamalari (ixtiyoriy — default qiymatlar yetarli) ───
# Pog'ona promotion: necha kun barqarorlikdan keyin pog'ona oshadi
TIER_PROMO_DAYS=5
# Minimal lot bilan savdoga ruxsat etilgan MAKSIMAL real risk (%)
MAX_ACTUAL_RISK_PCT=3.0
# Kontrakt hajmlari (broker boshqacha bo'lsa o'zgartiring)
CONTRACT_XAU=100
CONTRACT_ETH=1
# AI Kengash: true=yoqilgan, kunlik chaqiruv limiti
AI_COUNCIL=true
AI_COUNCIL_CALLS=30
# Signal umri (sekund) va spread kengayish chegarasi
SIGNAL_TTL_SEC=180
SPREAD_MULT=1.5
ENTRY_DRIFT_PCT=0.3
